# Default-ignore repository. The active product surface is explicitly allowed.
**

# Primary repository metadata and build configuration.
!.gitignore
!.gitattributes
!.github/
!.github/workflows/
!.github/workflows/ci.yml
!.clang-format
!CPPLINT.cfg
!CMakeLists.txt
!CMakePresets.json
!CONTEXT.md
!LICENSE
!readme.md
!cmake/
!cmake/**/
!cmake/**/*.cmake
!cmake/**/*.cmake.in
!cmake/*.hpp.in

# Installed public headers.
!include/
!include/**/
!include/**/*.h
!include/**/*.hpp

# Private kernel implementation.
!src/
!src/**/
!src/**/*.c
!src/**/*.cpp
!src/**/*.h
!src/**/*.hpp
!src/**/*.mm

# Maintained repository-owned operation implementations.
!plugins/
!plugins/ops/
!plugins/ops/**/
!plugins/ops/**/*.cpp
!plugins/ops/**/*.hpp
!plugins/ops/README.md
!plugins/ops/rgba32f/
!plugins/ops/rgba32f/*.c
!plugins/ops/rgba32f/*.h
!plugins/ops/rgba32f/*.metal
!plugins/ops/rgba32f/*.h.in
!plugins/ops/rgba32f/CMakeLists.txt

# Maintained public-API image example and shared acceptance fixture.
!examples/foundations_workflow/
!examples/foundations_workflow/*.cpp
!examples/foundations_workflow/*.hpp
!examples/foundations_workflow/*.md
!examples/foundations_workflow/CMakeLists.txt
!examples/
!examples/image_vertical/
!examples/image_vertical/*.cpp
!examples/image_vertical/*.hpp
!examples/image_vertical/CMakeLists.txt
!examples/s4_gpu_workflow/
!examples/s4_gpu_workflow/*.cpp
!examples/s4_gpu_workflow/*.hpp
!examples/s4_gpu_workflow/CMakeLists.txt
!examples/s3_image_workflow/
!examples/s3_image_workflow/*.cpp
!examples/s3_image_workflow/*.hpp
!examples/s3_image_workflow/CMakeLists.txt
!examples/regional_image_vertical/
!examples/regional_image_vertical/*.cpp
!examples/regional_image_vertical/CMakeLists.txt

# Maintained unit, integration, fixture, support, and consumer sources.
!tests/
!tests/**/
!tests/**/*.c
!tests/**/*.cpp
!tests/**/*.h
!tests/**/*.hpp
!tests/**/CMakeLists.txt
# Exact long-lived manual-fuzz seeds; generated corpus mutations stay ignored.
!tests/fuzz/corpus/operation_contract_ir/malformed-schema
!tests/fuzz/corpus/operation_contract_ir/valid-source

# Public documentation and faithful primary-repository mirrors.
!docs/
!docs/**/
!docs/**/*.md
!docs/**/*.png
!docs/**/*.jpg

# Personal overlay ownership. These paths remain ignored by primary Git even
# after the broad docs allowance above.
.git-personal/
AGENTS.md
CLAUDE.md
GEMINI.md
.claude/
.codex/
.github/skills/
.github/prompts/
.github/copilot-instructions.md
openspec/
docs/openspec-zh/
docs/agents/
feedback/

# Generated local state.
build/
build-*/
cache/
out/
CI-results/
tests/results/
.DS_Store
**/.DS_Store
*.o
*.a
*.so
*.dylib
*.dll
*.pyc
__pycache__/
