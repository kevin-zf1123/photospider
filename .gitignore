# Default-ignore repository. The active product surface is explicitly allowed.
**

# Primary repository metadata and build configuration.
!.gitignore
!.gitattributes
!.github/
!.github/workflows/
!.github/workflows/ci.yml
!.clang-format
!CPPLINT.cfg
!CMakeLists.txt
!CMakePresets.json
!CONTEXT.md
!LICENSE
!readme.md
!cmake/
!cmake/**/
!cmake/**/*.cmake
!cmake/**/*.cmake.in
!cmake/*.hpp.in

# Installed public headers.
!include/
!include/**/
!include/**/*.h
!include/**/*.hpp

# Private kernel implementation.
!src/
!src/**/
!src/**/*.c
!src/**/*.cpp
!src/**/*.h
!src/**/*.hpp
!src/**/*.mm

# Maintained repository-owned operation implementations.
!plugins/
!plugins/ops/
!plugins/ops/**/
!plugins/ops/**/*.cpp
!plugins/ops/**/*.hpp
!plugins/ops/02-format-color/*.c
!plugins/ops/02-format-color/*.h
!plugins/ops/02-format-color/prepare_*.py
!plugins/ops/03-generation/*.metal
!plugins/ops/03-generation/perlin.slang
!plugins/ops/03-generation/*.hpp.in
!plugins/ops/05-filter/*.metal
!plugins/ops/05-filter/*.hpp.in
!plugins/ops/gpu/*.metal
!plugins/ops/gpu/integer.slang
!plugins/ops/README.md
!plugins/ops/09-composite/inpaint_ns_license.txt
!plugins/ops/rgba32f/
!plugins/ops/rgba32f/*.c
!plugins/ops/rgba32f/*.h
!plugins/ops/rgba32f/*.metal
!plugins/ops/rgba32f/*.h.in
!plugins/ops/rgba32f/CMakeLists.txt

!docs/built-in_ops/04-mask-morphology/op_specs/catalog.json
!oracle/
!oracle/ops/
!oracle/ops/**/
!oracle/ops/**/*.py
!oracle/ops/format_color/external/*.c
!oracle/ops/format_color/external/*.cpp
!oracle/ops/**/*.hpp
!oracle/ops/**/*.md
!oracle/ops/**/*.json
!oracle/ops/**/*.jsonl
!oracle/ops/**/*.txt

# Maintained kernel unit/integration, package, fixture, and support sources.
!tests/
!tests/**/
!tests/**/*.c
!tests/**/*.cpp
!tests/**/*.h
!tests/**/*.hpp
!tests/fixtures/native_vulkan.slang
!tests/fixtures/native_scale.slang
!tests/**/CMakeLists.txt
# Exact long-lived manual-fuzz seeds; generated corpus mutations stay ignored.
!tests/fuzz/corpus/operation_contract_ir/malformed-schema
!tests/fuzz/corpus/operation_contract_ir/valid-source

# Public documentation and faithful primary-repository mirrors.
!docs/
!docs/**/
!docs/**/*.md
!docs/**/*.png
!docs/**/*.jpg
!docs/kernel-architecture/prototypes/ooo_executor.py

# Personal overlay ownership. These paths remain ignored by primary Git even
# after the broad docs allowance above.
.git-personal/
AGENTS.md
CLAUDE.md
GEMINI.md
.claude/
.codex/
.github/skills/
.github/prompts/
.github/copilot-instructions.md
docs/agents/
feedback/

# Generated local state.
build/
build-*/
cache/
out/
CI-results/
tests/results/
.DS_Store
**/.DS_Store
*.o
*.a
*.so
*.dylib
*.dll
*.pyc
__pycache__/

# Private dependency metadata and adapter; builders supply ignored upstream sources.
!third_party/
!third_party/SLEEF.md
!third_party/YYJSON.md
!third_party/photospider_sleef.c
!third_party/IK_LLAMA_LICENSE.txt
/third_party/sleef/
/third_party/yyjson/

!tools/
