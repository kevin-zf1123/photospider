# Default-ignore repository. The active product surface is explicitly allowed.
**

# Primary repository metadata and build configuration.
!.gitignore
!.gitattributes
!.github/
!.github/workflows/
!.github/workflows/ci.yml
!.clang-format
!CPPLINT.cfg
!CMakeLists.txt
!CMakePresets.json
!CONTEXT.md
!LICENSE
!readme.md
!cmake/
!cmake/**/
!cmake/**/*.cmake
!cmake/**/*.cmake.in

# Installed public headers.
!include/
!include/**/
!include/**/*.h
!include/**/*.hpp

# Private kernel implementation.
!src/
!src/**/
!src/**/*.c
!src/**/*.cpp
!src/**/*.h
!src/**/*.hpp
!src/**/*.mm

# Maintained unit, integration, fixture, support, and consumer sources.
!tests/
!tests/**/
!tests/**/*.c
!tests/**/*.cpp
!tests/**/*.h
!tests/**/*.hpp
!tests/**/CMakeLists.txt

# Public documentation and faithful primary-repository mirrors.
!docs/
!docs/**/
!docs/**/*.md
!docs/**/*.png
!docs/**/*.jpg

# Personal overlay ownership. These paths remain ignored by primary Git even
# after the broad docs allowance above.
.git-personal/
AGENTS.md
CLAUDE.md
GEMINI.md
.claude/
.codex/
.github/skills/
.github/prompts/
.github/copilot-instructions.md
openspec/
docs/openspec-zh/
docs/agents/
feedback/

# Generated local state.
build/
build-*/
cache/
out/
CI-results/
tests/results/
.DS_Store
**/.DS_Store
*.o
*.a
*.so
*.dylib
*.dll
*.pyc
__pycache__/
