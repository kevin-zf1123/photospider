# The tag is a review hint only; the OCI index digest is authoritative.
FROM ubuntu:24.04@sha256:33ceb71981b602c1a7443a53469e4dba065f7503eab3078a2d7a57a2ab987517

# Keep these values synchronized with ci/locks/ci-image-lock.json. The protected
# lock verifier rejects drift before an image is built.
ARG APT_SNAPSHOT=20260825T000000Z
ARG GH_CLI_VERSION=2.98.0
ARG GH_CLI_AMD64_SHA256=3b8ac6b30336802fc1a858d7c084e11cdf24ac1a761ca90b68022d7d729208de
ARG GH_CLI_ARM64_SHA256=cf689084f3a3618f7eae4a2420d335d74626d65f5e594b9828d125d69f800d86
ARG CI_IMAGE_INPUT_MANIFEST_SHA256
ARG CI_IMAGE_SOURCE_COMMIT

LABEL org.opencontainers.image.revision="$CI_IMAGE_SOURCE_COMMIT" \
      org.photospider.ci.input-manifest-sha256="$CI_IMAGE_INPUT_MANIFEST_SHA256"

ENV DEBIAN_FRONTEND=noninteractive
ENV VENV=/opt/venv
ENV PATH="$VENV/bin:$PATH"

COPY ci/locks/ubuntu-24.04-packages.lock /tmp/ci-locks/ubuntu-24.04-packages.lock
COPY ci/locks/ubuntu-24.04-snapshot.sources.in /tmp/ci-locks/ubuntu-24.04-snapshot.sources.in
COPY ci/locks/requirements-ci.txt /tmp/ci-locks/requirements-ci.txt
COPY ci/scripts/ci_image_install.sh /tmp/ci-image-install.sh

# The minimal Ubuntu base has no TLS trust bundle. Bootstrap only the exact
# OpenSSL/CA closure from immutable snapshot URLs whose bytes are SHA-256 locked
# in ci-image-lock.json. No live APT transaction may precede snapshot mode.
ADD --checksum=sha256:6bac2a01979e210d9eac1d4d56747ec709ea60654744d66705dc3c36e7629e50 \
    https://snapshot.ubuntu.com/ubuntu/20260825T000000Z/pool/main/c/ca-certificates/ca-certificates_20260601~24.04.1_all.deb \
    /tmp/ci-bootstrap/ca-certificates.deb
ADD --checksum=sha256:321b30ad5a1c3783cb3d73ae439f824f6d3874d76a93a62f4a984959b490aa7b \
    https://snapshot.ubuntu.com/ubuntu/20260825T000000Z/pool/main/o/openssl/openssl_3.0.13-0ubuntu3.12_amd64.deb \
    /tmp/ci-bootstrap/openssl-amd64.deb
ADD --checksum=sha256:777b636c291fd2a5f269b21c110bf226d2cfde43b2c0d1f3d35ff41c775ef847 \
    https://snapshot.ubuntu.com/ubuntu/20260825T000000Z/pool/main/o/openssl/openssl_3.0.13-0ubuntu3.12_arm64.deb \
    /tmp/ci-bootstrap/openssl-arm64.deb

# The protected installer owns the complete active network/install surface.
# Docker invokes it once; its full bytes and active statement stream are locked.
RUN bash /tmp/ci-image-install.sh

WORKDIR /workspace
