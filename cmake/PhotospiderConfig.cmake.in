@PACKAGE_INIT@

if(NOT Photospider_FIND_COMPONENTS OR
   "kernel" IN_LIST Photospider_FIND_COMPONENTS OR
   "ops" IN_LIST Photospider_FIND_COMPONENTS)
  include(CMakeFindDependencyMacro)
  find_dependency(Threads)
  if(@PHOTOSPIDER_ENABLE_VULKAN@)
    find_dependency(Vulkan)
  endif()
endif()

set(Photospider_kernel_FOUND TRUE)
set(Photospider_ops_FOUND @PHOTOSPIDER_BUILD_OPS@)
set(Photospider_ops_headers_FOUND @PHOTOSPIDER_BUILD_OPS@)
set(Photospider_operation_sdk_FOUND TRUE)

foreach(_Photospider_component IN LISTS Photospider_FIND_COMPONENTS)
  if(NOT _Photospider_component STREQUAL "kernel" AND
     NOT _Photospider_component STREQUAL "ops" AND
     NOT _Photospider_component STREQUAL "operation_sdk" AND
     NOT _Photospider_component STREQUAL "ops_headers")
    set(Photospider_${_Photospider_component}_FOUND FALSE)
  endif()
endforeach()

check_required_components(Photospider)
include("${CMAKE_CURRENT_LIST_DIR}/PhotospiderTargets.cmake")
