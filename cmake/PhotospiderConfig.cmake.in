@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(@PHOTOSPIDER_BUILD_EXECUTOR@ AND @PHOTOSPIDER_ENABLE_VULKAN@ AND (NOT Photospider_FIND_COMPONENTS OR
   "kernel" IN_LIST Photospider_FIND_COMPONENTS OR "executor_physical" IN_LIST Photospider_FIND_COMPONENTS OR "execution_default" IN_LIST Photospider_FIND_COMPONENTS OR "benchmark_tools" IN_LIST Photospider_FIND_COMPONENTS))
  find_dependency(Vulkan)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/PhotospiderTargets.cmake")
foreach(component IN ITEMS kernel data model program operation_runtime plugin_host operation_sdk mapper_geometry
    compiler compiler_default frontend_dag optimizer_deduplicate planner_static_tiles executor_physical
    execution execution_default ops ops_runtime ops_sdk ops_headers benchmark_tools result_files)
  if(TARGET Photospider::${component})
    set(Photospider_${component}_FOUND TRUE)
  else()
    set(Photospider_${component}_FOUND FALSE)
  endif()
endforeach()
check_required_components(Photospider)
